includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
        - plugins/

    level: 8

    bootstrapFiles:
        - tests/Support/phpstan-bootstrap.php

    excludePaths:
        - plugins/*/config/*
