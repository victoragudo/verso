		<description></description>
		<content:encoded><![CDATA[<!-- wp:paragraph -->
<p>Lisbon rewards the slow walker. We spent <strong>two days</strong> climbing <a href="https://harbourlight.example/tag/lisbon/">its seven hills</a>.</p>
<!-- /wp:paragraph -->

<!-- wp:heading {"level":3} -->
<h3 class="wp-block-heading">Where we stayed</h3>
<!-- /wp:heading -->

<!-- wp:list -->
<ul class="wp-block-list"><!-- wp:list-item -->
<li>A small guesthouse in Graça</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Ten minutes from the <em>miradouro</em></li>
<!-- /wp:list-item --></ul>
<!-- /wp:list -->

<!-- wp:list {"ordered":true} -->
<ol class="wp-block-list"><li>Buy a Viva Viagem card</li><li>Take tram 28 early</li></ol>
<!-- /wp:list -->

<!-- wp:quote -->
<blockquote class="wp-block-quote"><!-- wp:paragraph -->
<p>Saudade is a longing for something you may never have had.</p>
<!-- /wp:paragraph --><cite>A fado singer in Mouraria</cite></blockquote>
<!-- /wp:quote -->

<!-- wp:image {"id":101,"sizeSlug":"large","linkDestination":"none"} -->
<figure class="wp-block-image size-large"><img src="https://harbourlight.example/wp-content/uploads/2024/03/tram-28-alfama-1024x683.jpg" alt="Tram 28 in Alfama" class="wp-image-101" width="1024" height="683"/><figcaption class="wp-element-caption">Tram 28 at seven in the morning</figcaption></figure>
<!-- /wp:image -->

<!-- wp:gallery {"ids":[101,102],"linkTo":"none"} -->
<figure class="wp-block-gallery has-nested-images columns-default"><!-- wp:image {"id":101} -->
<figure class="wp-block-image"><img src="https://harbourlight.example/wp-content/uploads/2024/03/tram-28-alfama.jpg" alt="" class="wp-image-101"/></figure>
<!-- /wp:image -->

<!-- wp:image {"id":102} -->
<figure class="wp-block-image"><img src="https://harbourlight.example/wp-content/uploads/2024/03/pasteis-de-nata.png" alt="" class="wp-image-102"/></figure>
<!-- /wp:image --></figure>
<!-- /wp:gallery -->

<!-- wp:embed {"url":"https://www.youtube.com/watch?v=Kx3pQ8xL2aE","type":"video","providerNameSlug":"youtube"} -->
<figure class="wp-block-embed is-type-video is-provider-youtube"><div class="wp-block-embed__wrapper">
https://www.youtube.com/watch?v=Kx3pQ8xL2aE
</div><figcaption class="wp-element-caption">Fado in a tiny tasca</figcaption></figure>
<!-- /wp:embed -->

<!-- wp:code -->
<pre class="wp-block-code"><code class="language-bash">curl -s https://api.carrismetropolitana.pt/stops &amp;&amp; echo "ok"</code></pre>
<!-- /wp:code -->

<!-- wp:separator -->
<hr class="wp-block-separator has-alpha-channel-opacity"/>
<!-- /wp:separator -->

<!-- wp:columns -->
<div class="wp-block-columns"><!-- wp:column -->
<div class="wp-block-column"><!-- wp:paragraph -->
<p>Morning: Castelo de São Jorge.</p>
<!-- /wp:paragraph --></div>
<!-- /wp:column -->

<!-- wp:column -->
<div class="wp-block-column"><!-- wp:paragraph -->
<p>Evening: sardines in Alfama.</p>
<!-- /wp:paragraph --></div>
<!-- /wp:column --></div>
<!-- /wp:columns -->

<!-- wp:buttons -->
<div class="wp-block-buttons"><!-- wp:button {"className":"is-style-outline"} -->
<div class="wp-block-button is-style-outline"><a class="wp-block-button__link wp-element-button" href="https://harbourlight.example/lisbon-map/">Download our walking map</a></div>
<!-- /wp:button --></div>
<!-- /wp:buttons -->

<!-- wp:table -->
<figure class="wp-block-table"><table><tbody><tr><td>Tram 28</td><td>€3.10</td></tr></tbody></table></figure>
<!-- /wp:table -->

<!-- wp:group {"layout":{"type":"constrained"}} -->
<div class="wp-block-group"><!-- wp:paragraph -->
<p>Thanks for reading.</p>
<!-- /wp:paragraph --></div>
<!-- /wp:group -->

<!-- wp:more -->
<!--more-->
<!-- /wp:more -->]]></content:encoded>
